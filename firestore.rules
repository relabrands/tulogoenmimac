rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Espacios (spots): lectura pública, edición solo por usuario autenticado (admin)
    match /spots/{spotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Solicitudes (claims): cualquiera puede enviar una solicitud, lectura y gestión solo admin
    match /claims/{claimId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Configuración y perfil: lectura pública, edición solo admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
